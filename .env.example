# JWT
JWT_SECRET=gere-com-node-e-console.log-require-crypto-.randomBytes-32-.toString-hex
JWT_EXPIRY=7d

# Database
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ofertarelay

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui
MERCADOPAGO_WEBHOOK_SECRET=gere-com-node-e-console.log-require-crypto-.randomBytes-32-.toString-hex
MERCADOPAGO_API_URL=https://api.mercadopago.com

# Plano (usado para criar a assinatura no MP)
PLAN_NAME=OfertaRelay Pro
PLAN_AMOUNT=199
PLAN_CURRENCY=BRL

# URLs do sistema (necessário para o checkout do MP)
APP_URL=https://ofertarelay-ofertarelay-api.fgxtfw.easypanel.host

# Webhook
WEBHOOK_RATE_LIMIT=100
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_CLEANUP_DAYS=90

# Notificações
ENVIAR_EMAIL_CONFIRMACAO_PAGAMENTO=true
EMAIL_ADMIN=admin@ofertarelay.com

# Evolution API (WhatsApp)
EVOLUTION_API_KEY=sua-api-key-aqui
EVOLUTION_API_URL=https://evolution-api.com

# Bull / Redis queues
BULL_SYNC_QUEUE=whatsapp-sync

# n8n Integration
N8N_WEBHOOK_SECRET=gere-com-node-e-console.log-require-crypto-.randomBytes-32-.toString-hex
N8N_RATE_LIMIT_CONFIGURACOES=10
N8N_RATE_LIMIT_GRUPOS=10
N8N_RATE_LIMIT_LOG=100
N8N_REQUEST_TIMEOUT_MS=30000
N8N_LOG_REQUESTS=true
N8N_LOG_LEVEL=info
# Chave exigida no header x-n8n-key das rotas /api/n8n (vazio = sem exigência, compatível)
N8N_API_KEY=
N8N_RATE_LIMIT_COMPAT=600

# ── Melhorias (todas opcionais; sem elas o comportamento atual é mantido) ──
# E-mails com acesso de administrador (separados por vírgula)
ADMIN_EMAILS=contato@ofertarelay.com.br
# true = bloqueia envios de quem está com teste vencido/assinatura inativa
BLOQUEAR_PLANO_INATIVO=false
# Criptografa credenciais salvas (cookies, App Secret, token do bot, senha SMTP).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde em lugar seguro: sem ela as credenciais criptografadas não podem ser lidas.
CHAVE_CRIPTOGRAFIA=
# Executa as migrations automaticamente ao iniciar (false para desligar)
RODAR_MIGRATIONS=true
# Endereço público do site (links de e-mail e landing pages). Ex.: https://ofertarelay.com.br
PUBLIC_URL=
APP_URL=
AJUDA_RATE_LIMIT=20
PUBLIC_RATE_LIMIT=120

# Servidor de e-mail: configure pelo painel admin (Admin > E-mail).
# Estas variáveis só são usadas se nada tiver sido salvo no painel.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=OfertaRelay
